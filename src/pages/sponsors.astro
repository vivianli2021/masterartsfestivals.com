---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="Sponsors">
  <section class="section">
    <h1>Support the Team</h1>
    <p class="card">Your sponsorship fuels student-led engineering, outreach, and competition travel. We offer flexible tiers and custom packages.</p>
    <div class="gallery">
      <div class="card">
        <h3>Supporter</h3>
        <p>$250 — Logo on website</p>
      </div>
      <div class="card">
        <h3>Partner</h3>
        <p>$1,000 — Logo + social mention</p>
      </div>
      <div class="card">
        <h3>Lead Sponsor</h3>
        <p>$5,000 — Prominent branding + press</p>
      </div>
    </div>
    <p style="margin-top:14px">Email <a href="mailto:sponsor@masterartsfestivals.com">sponsor@masterartsfestivals.com</a> to pledge.</p>
  </section>
</BaseLayout>

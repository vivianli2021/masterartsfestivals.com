---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="Team">
  <section class="section">
    <h1>Team</h1>
    <p class="card">Meet the students, mentors, and alumni that power the Master Arts Festival rocket team.</p>
    <div class="gallery">
      <div class="card"><strong>Avionics</strong><p>Flight computers, telemetry, and ground systems.</p></div>
      <div class="card"><strong>Propulsion</strong><p>Motors, static fires, and thrust optimization.</p></div>
      <div class="card"><strong>Structures</strong><p>Airframes, recovery, and composites.</p></div>
      <div class="card"><strong>Operations</strong><p>Safety, logistics, and fundraising.</p></div>
    </div>
  </section>
</BaseLayout>
